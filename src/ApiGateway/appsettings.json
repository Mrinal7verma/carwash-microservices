{
  "Urls": "http://localhost:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "customer-root-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers"
        }
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "washer-root-route": {
        "ClusterId": "washer-cluster",
        "Match": {
          "Path": "/api/washers"
        }
      },
      "washer-route": {
        "ClusterId": "washer-cluster",
        "Match": {
          "Path": "/api/washers/{**catch-all}"
        }
      },
      "booking-root-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/bookings"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "customer-destination": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "washer-cluster": {
        "Destinations": {
          "washer-destination": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-destination": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}
